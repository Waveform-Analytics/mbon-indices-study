# IDE
.idea/
.vscode/

# Quarto rendered assets (HTML is committed for easy viewing)
docs/results-viewer_files/

# Temporary files
tmp_*.md

# Generated presentations (but allow specific tracked ones)
docs/presentations/*.html
!docs/presentations/biostats-review-2025-12-12.html

# Generated/intermediate data (regenerated by pipeline)
data/interim/
data/processed/
data/external/

# Raw data: older/alternate versions excluded
data/raw/indices/culled/

# Results: generated outputs (regenerated by pipeline)
results/models/
results/diagnostics/
results/cv/
results/figures/
results/tables/

# Logs (timestamped execution logs - regenerated on each run)
results/logs/*.txt
results/logs/archive/

# Python/R caches and environments
__pycache__/
.ipynb_checkpoints/
.venv/
.env
.Rhistory
.Rproj.user/
renv/library/
renv/staging/

# Sensitivity analysis (large parquet files, regenerated)
results/sensitivity/*.parquet

# OS/Editor
.DS_Store
Rplots.pdf
~$*
